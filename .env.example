FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_UPLOAD_URL=
QINIU_PUBLIC_BASE_URL=

# LLM proxy (/v1/llm/ark, Volcengine Ark); enabled only when the key is set
LLM_ARK_API_KEY=
# Optional: comma-separated model allowlist, body limit, per-IP rate limit
# LLM_ARK_MODELS=doubao-seed-2-1-lite-260915
# LLM_MAX_BODY_MB=20
# LLM_RATE_PER_MINUTE=60

# TTS (/v1/tts, Volcengine Doubao speech seed-tts-2.0); enabled only when the key is set
VOLC_SPEECH_API_KEY=
# Optional: comma-separated speaker allowlist, cache dir (default: <DB_PATH dir>/tts-cache), per-IP rate limit
# VOLC_TTS_SPEAKERS=en_female_dacey_uranus_bigtts,zh_female_vv_uranus_bigtts
# TTS_CACHE_DIR=./data/tts-cache
# TTS_RATE_PER_MINUTE=120

HTTP_ADDR=:8080
DB_PATH=./data/dict.db
SCHEMA_PATH=./migrations/schema.sql
